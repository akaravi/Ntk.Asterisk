{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-check.tree.schema.json",
  "title": "BrowserCheck_Tree",
  "type": "object",
  "required": ["sessionId", "productId", "createdAt", "hosts", "stats"],
  "properties": {
    "sessionId": { "type": "string" },
    "productId": { "type": "string" },
    "createdAt": { "type": "string" },
    "skillsInvoked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skillId", "phase"],
        "properties": {
          "skillId": { "type": "string" },
          "phase": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "baseUrl", "nodes"],
        "properties": {
          "id": { "type": "string" },
          "baseUrl": { "type": "string" },
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/$defs/node" }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "pass": { "type": "integer" },
        "fail": { "type": "integer" },
        "pending": { "type": "integer" },
        "skipped": { "type": "integer" },
        "fixesApplied": { "type": "integer" }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "url", "viewport", "status"],
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "url": { "type": "string" },
        "viewport": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "pass", "fail", "skipped"]
        },
        "steps": { "type": "object" },
        "findings": { "type": "array" },
        "fixes": { "type": "array" },
        "designAuditor": { "type": "object" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  }
}
