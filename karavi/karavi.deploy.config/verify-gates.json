{
  "gates": [
    {
      "id": "karavi-structure",
      "script": "karavi.scripts.tools/verify.karavi-structure.ps1",
      "required": true
    },
    {
      "id": "dotnet-build",
      "command": "dotnet build Ntk.Asterisk.sln -c Release --nologo",
      "required": true
    },
    {
      "id": "ng-build-admin",
      "command": "ng build --configuration=production",
      "cwd": "src/Angular/AdminPanel",
      "required": true
    },
    {
      "id": "ng-build-user",
      "command": "ng build --configuration=production",
      "cwd": "src/Angular/UserPanel",
      "required": true
    },
    {
      "id": "no-secrets-in-config",
      "note": "Scan diff for Deploy_FTP.info, passwords, tokens, AMI/ARI credentials in base appsettings.json",
      "required": true
    }
  ]
}
