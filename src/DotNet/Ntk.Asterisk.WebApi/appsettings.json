{
  "Asterisk": {
    "Servers": [{
      "Id": "default",
      "Host": "127.0.0.1",
      "Ami": { "Port": 5038, "TimeoutMs": 5000, "PingIntervalMs": 10000, "KeepAlive": true, "AutoReconnect": true, "FireAllEvents": true },
      "Ari": { "BaseUrl": "http://127.0.0.1:8088/ari", "Application": "stasis_app" },
      "FastAgi": { "ListenPort": 4573, "MaxConcurrentConnections": 100 }
    }]
  },
  "Monitoring": { "SnapshotIntervalMs": 1000, "TrackQueues": true, "TrackChannels": true, "TrackPeers": true, "DefaultChannelTech": "PJSIP", "SpyDefaultMode": "Listen", "AclEnabled": true },
  "Recording": { "StorageProvider": "FileSystem", "FileSystem": { "BasePath": "App_Data/recordings", "PathFormat": "{Year}/{Month}/{Day}/{CallId}_{Direction}_{Caller}_{Called}.{Ext}", "DefaultAudioFormat": "Wav" }, "Retention": { "Enabled": true, "RetentionDays": 90, "CleanupIntervalHours": 24, "AutoArchive": false } },
  "QueueAcl": { "Enabled": true, "UsersFilePath": "App_Data/queue-acl-users.json" },
  "Database": { "Provider": "None" },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
