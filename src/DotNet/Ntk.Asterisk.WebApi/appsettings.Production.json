{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5310"
      }
    }
  },
  "Asterisk": {
    "Host": "",
    "Port": 5038,
    "Username": "",
    "Secret": "",
    "ChannelTech": "PJSIP",
    "DefaultTrunk": "",
    "TrunkPeerFilter": "^(trunk|Trunk|TRUNK)",
    "OriginateVia": "LocalContext",
    "OriginateContext": "from-internal",
    "MusicOnHoldClass": "default",
    "DefaultTimeoutMs": 30000,
    "DefaultCallerId": "NtkCall",
    "KeepAlive": true,
    "PingIntervalMs": 10000,
    "AutoConnectOnStartup": true,
    "RecordingEnabled": true,
    "RecordingLocalDirectory": "",
    "RecordingHttpBaseUrl": "",
    "RecordingAsteriskDirectory": "/var/spool/asterisk/monitor",
    "RecordingFormat": "wav"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "WebPhone": {
    "EnableTransfer": true,
    "EnableConference": true,
    "EnableRecordAll": false,
    "EnableVideo": true,
    "EnablePresence": true,
    "EnableMwi": true,
    "DefaultHintContext": "from-internal",
    "DefaultMailboxContext": "default",
    "RequireApiKey": true,
    "ApiKey": ""
  },
  "QueueAcl": {
    "RequireLogin": false,
    "TokenTtlMinutes": 480
  },
  "QueueStats": {
    "SnapshotIntervalMinutes": 5,
    "RetentionDays": 14,
    "MaxSamples": 50000
  }
}
