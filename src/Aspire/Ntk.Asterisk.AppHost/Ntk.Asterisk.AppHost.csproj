    <ProjectReference Include="..\..\DotNet\Asterisk.Console.AMI\Asterisk.Console.AMI.csproj" />
    <ProjectReference Include="..\..\DotNet\Asterisk.Console.ARI\Asterisk.Console.ARI.csproj" />
    <ProjectReference Include="..\..\DotNet\Asterisk.WinForm.AMI\Asterisk.WinForm.AMI.csproj" />
